#ifndef CONFIG_H
#define CONFIG_H

// I2C Configuration
#define I2C_BUS 1
#define I2C_SDA_PIN 21
#define I2C_SCL_PIN 22
#define I2C_SPEED 50000  // 50kHz (slower for reliability with multiple slaves)

// Mining Configuration
#define MAX_ESP32_SLAVES 16
#define I2C_SCAN_START 0x08
#define I2C_SCAN_END 0x78
#define NONCE_INCREMENT 0x10

// Stratum Pool Configuration
#define DEFAULT_POOL_HOST "public-pool.io"
#define DEFAULT_POOL_PORT 3333
#define DEFAULT_POOL_USER ""  // Set your BTC address
#define DEFAULT_POOL_PASS "x"

// Timing (milliseconds)
#define STRATUM_RECONNECT_INTERVAL 5000
#define JOB_FEED_INTERVAL 100
#define RESULT_HARVEST_INTERVAL 50
#define SHARE_SUBMIT_TIMEOUT 10000

// Buffer sizes
#define BUFFER_SIZE 2048
#define MAX_MERKLE_BRANCHES 32

#endif // CONFIG_H
